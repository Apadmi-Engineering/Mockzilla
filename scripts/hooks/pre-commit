#!/usr/bin/env bash

set -euo pipefail

LC_ALL=C

repo_root="$(git rev-parse --show-toplevel)"

# Check if we need to run spotless (only when staged .kt files have changed)
kt_changes="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.kt$' || true)"
if [[ -n "$kt_changes" ]]; then
    # Run spotless
    echo "🦥 Running spotlessCheck 🦥"
    "$repo_root/scripts/run-spotless.sh"
    echo "👍 Passed spotlessCheck 👍"
fi

exit 0
